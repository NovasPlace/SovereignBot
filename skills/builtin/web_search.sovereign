---
name: web_search
version: 1.0.0
author: sovereign-core
trust_tier: core
description: Search the web via DuckDuckGo Instant Answers API. No API key required. Returns top results with titles, URLs, and snippets.
permissions:
  - net:read
network_whitelist:
  - api.duckduckgo.com
  - duckduckgo.com
---
import json
import urllib.parse
import urllib.request

def search(query: str, max_results: int = 5) -> list[dict]:
    """Run a DuckDuckGo search. Returns list of {title, url, snippet}."""
    params = urllib.parse.urlencode({
        "q": query,
        "format": "json",
        "no_redirect": 1,
        "no_html": 1,
        "skip_disambig": 1,
    })
    url = f"https://api.duckduckgo.com/?{params}"
    req = urllib.request.Request(url, headers={"User-Agent": "Sovereign/1.0"})

    with urllib.request.urlopen(req, timeout=10) as resp:
        data = json.loads(resp.read())

    results = []

    # Instant answer
    if data.get("AbstractText"):
        results.append({
            "title": data.get("Heading", "Answer"),
            "url": data.get("AbstractURL", ""),
            "snippet": data["AbstractText"][:400],
        })

    # Related topics
    for topic in data.get("RelatedTopics", [])[:max_results - len(results)]:
        if isinstance(topic, dict) and topic.get("Text"):
            results.append({
                "title": topic.get("Text", "")[:80],
                "url": topic.get("FirstURL", ""),
                "snippet": topic.get("Text", "")[:300],
            })

    return results[:max_results]


# === Sovereign entry point ===
query = action_payload.get("query", "")
max_results = int(action_payload.get("max_results", 5))

if not query:
    sovereign_return({"output": "No search query provided.", "success": False})

try:
    results = search(query, max_results)
    if not results:
        sovereign_return({"output": f"No results found for: {query}", "success": True})

    lines = [f"Search: {query}\n"]
    for i, r in enumerate(results, 1):
        lines.append(f"{i}. {r['title']}")
        if r["url"]:
            lines.append(f"   {r['url']}")
        lines.append(f"   {r['snippet']}\n")

    sovereign_return({"output": "\n".join(lines), "success": True, "result_count": len(results)})

except Exception as e:
    sovereign_return({"output": f"Search failed: {e}", "success": False})
